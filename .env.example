DISCORD_TOKEN=your_discord_bot_token
CLIENT_ID=your_discord_application_id
MORALIS_API_KEY=your_moralis_api_key
LOG_CHANNEL_ID=your_log_channel_id
TZ=UTC

# ── Telegram platform ──
# Set PLATFORM=telegram on the Telegram Railway service (leave unset for Discord).
# Deliberately unset on Telegram: DISCORD_TOKEN, CLIENT_ID, GUILD_ID, and Discord/webhook/warden vars.
# PLATFORM=telegram
# TELEGRAM_BOT_TOKEN=from_botfather
# SUMMARY_CHANNEL_ID=telegram_chat_id   # negative for supergroups; stored as a string
# ENABLED_CHAINS=solana,robinhood,base,ink,hype,ethereum
# AUTO_FIB_TRACKING=true
# FIB_MIN_MCAP=100000

# Optional: comma-separated chains for auto-track (default: solana only)
# Auto-track Solana + Base (recommended — avoids bare-0x ambiguity with Robinhood)
ENABLED_CHAINS=solana,base,ink,hype,ethereum
# Launch Robinhood: ENABLED_CHAINS=solana,robinhood
# All EVM: ENABLED_CHAINS=solana,base,robinhood,ink,hype,ethereum

# Base JSON-RPC for optional native-B20 detection. Public endpoint is rate-limited;
# use an Alchemy/Infura/QuickNode URL for production.
BASE_RPC_URL=https://mainnet.base.org

# Optional API keys (rug / research commands)
ANTHROPIC_API_KEY=
TWITTERAPI_KEY=
BITQUERY_API_KEY=
RUGCHECK_API_KEY=
HELIUS_API_KEY=
# Phase 7 dev-sell webhooks (all three required to enable)
# WEBHOOK_PUBLIC_URL=https://your-railway-app.up.railway.app
# WEBHOOK_SECRET=shared-secret-with-helius-authHeader
# SUMMARY_CHANNEL_ID=discord-channel-for-daily-weekly-recaps
DATABASE_URL=file:./research.db

# --- Warden auditor (main bot) ---
# WARDEN_TOKEN=32+_char_random_bearer_token
# GIT_SHA=set_by_railway_build

# --- Warden service (separate Railway service — railway.warden.toml) ---
# BOT_STATUS_URL=https://your-main-bot.up.railway.app
# WARDEN_TOKEN=same_as_main_bot
# WARDEN_WEBHOOK_URL=discord_webhook_for_audit_channel
# WARDEN_CHANNEL_ID=1484009058401910844
# DISCORD_TOKEN=fallback_if_no_webhook_(posts_to_WARDEN_CHANNEL_ID)
# OWNER_ID=your_discord_user_id_for_critical_pings

# --- Alert gate (maintenance & comeback) ---
# MAINTENANCE_MODE=1          — suppress milestone/price alerts; bot still polls and new CA confirmations still post
# COMEBACK_SILENCE_CYCLES=3   — on deploy: N poll cycles sync milestone state only, then alerts auto-resume
#
# --- Railway persistence (required for 500+ tokens) ---
# Mount a volume at /data — tracked.json + milestone state live there automatically.
# Without /data volume, redeploys wipe milestone history → catch-up alert spam.

# ── Fibonacci retracement tracker (fib/config.js documents every knob) ──
# FIB_TRACKING_ENABLED=true       # master switch
# AUTO_FIB_TRACKING=false         # auto-fib every tracked token once it clears the floor
# FIB_MIN_MCAP=300000             # eligibility floor (auto waits; /fibtrack add rejects)
# FIB_DEFAULT_TIMEFRAME=1h        # anchor timeframe (standard mode)
# FIB_FAST_TIMEFRAME=5m           # anchor timeframe (fast mode, launch fallback on)
# FIB_GOLDEN_UPPER=0.382          # golden alert (pelpa: enter .382)
# FIB_GOLDEN_LOWER=0.382
# FIB_HIGH_CONFIRM_RATIO=0.786    # swing-detector high confirmation only
# FIB_ALERT_LEVELS=0.236          # lowest ratio = ENTRY (chart alert); .50 re-pull later
# FIB_MIN_IMPULSE_PCT=1.0         # low→high must be ≥ 2x to anchor
# FIB_REANCHOR_THRESHOLD=0.25     # post-alert high break > 25% ⇒ new cycle
# FIB_CONFIRM_CLOSES=2            # standard-mode confirmation (consecutive 1m closes)
# FIB_CHART_ENABLED=true          # kill-switch: false ⇒ text-only entry alerts
# FIB_COMMAND_ALLOWED_ROLES=      # role IDs allowed to mutate; empty = everyone
# FIB_GT_NETWORK_ROBINHOOD=robinhood  # GeckoTerminal slug override if needed
# FIB_GT_NETWORK_BASE=base
# LIQ_DIVERGENCE_ALERTS=1             # set to re-enable liquidity-divergence Discord posts (off by default)

# ── Deployment target (one Railway service = one profile) ──
# Each bot instance uses its own DISCORD_TOKEN + channel IDs. Feature flags route
# output to the right channel without code changes.
#
# Personal dev (your sandbox guild):
#   MINT_SCANNER_CHANNEL_ID=1536502941924593827
#   ALERT_CARDS_CHANNEL_ID=<personal preview channel>
#
# TP4APH main Discord (production):
#   MINT_SCANNER_CHANNEL_IDS=1358929055604408465,1536502941924593827
#     # 1358929055604408465 = nft-land / chain-radar in TP4APH (NOT the token take-profit channel)
#   NFT_TP_CHANNEL_IDS=1358929055604408465   # NFT take-profits cards (#nft-land)
#     # 1536502941924593827 = your personal dev mirror
#   ALERT_CARDS_CHANNEL_ID=1452152164699869298   # milestone / auto-track trencher cards
#   ALERT_CARDS_ENABLED=true
#
# Telegram (separate Railway service — set PLATFORM=telegram, omit Discord vars):
#   PLATFORM=telegram
#   TELEGRAM_BOT_TOKEN=...
#   SUMMARY_CHANNEL_ID=<telegram chat id>

# ── Mint scanner (mintscan/) ──
# MINT_SCANNER_ENABLED=false          # master switch; nothing runs unless true
# MINT_SCANNER_CHAIN=robinhood        # robinhood | ethereum | base
# MINT_SCANNER_CHANNEL_ID=            # single Discord channel (legacy)
# MINT_SCANNER_CHANNEL_IDS=1358929055604408465,1536502941924593827
# MINT_SCANNER_RPC_URLS=              # comma list; else Alchemy key, else public RPC
# MINT_SCANNER_INTERVAL_SEC=45
# MINT_SCANNER_WINDOW_BLOCKS=         # per-chain default (robinhood 1200 ≈ 5 min)
# MINT_SCANNER_WARM_MINTS=25
# MINT_SCANNER_HOT_MINTS=60
# MINT_SCANNER_MOON_MINTS=120
# MINT_SCANNER_MIN_UNIQUE=15
# MINT_SCANNER_MIN_MINT_PCT=40        # Discord alert only at this % of max supply
# MINT_SCANNER_LOG_NEAR_MISSES=true   # persist + console-log sub-threshold tier hits
# MINT_SCANNER_REQUIRE_OPENSEA=       # defaults on when OPENSEA_API_KEY is set
# MINT_SCANNER_BLOCK_FACTORY=true
# MINT_SCANNER_DEBUG=false

# OPENSEA_API_KEY=                  # mintscan metadata + nfttp floor tracking (same key)

# ── NFT take-profits (nfttp/) — OpenSea floor vs OG call, same cards as token TP ──
# NFT_TP_ENABLED=false              # master switch; nothing runs unless true
# NFT_TP_CHANNEL_ID=1358929055604408465   # TP4APH #nft-land (default in code)
# NFT_TP_CHANNEL_IDS=1358929055604408465
# NFT_TP_INTERVAL_SEC=120
# NFT_TP_MAX_TIER=20                # 20x card = 21× floor
# NFT_TP_CHAINS=ethereum,base,robinhood
# NFT_TP_TRACK_CONTRACTS=false      # off: URLs/slugs only (do not steal token CAs)
# NFT_TP_DEBUG=false
# See docs/NFT_TP.md

# ── Trencher alert cards (alertCards/) ──
# ALERT_CARDS_ENABLED=true            # unset/true → trencher cards in every Discord channel
# ALERT_CARDS_ENABLED=false           # reference-only: old EmbedBuilder cards
# ALERT_CARDS_CHANNEL_ID=             # unused (channel gate retired)
# ALERT_CARDS_ALL_CHANNELS=           # unused (trencher cards are always all-channel when enabled)
#
# ── Blocked channels (zero bot activity) ──
# BLOCKED_CHANNEL_IDS=1536177376508121088   # no posts, autotrack, slash cmds, or banners
# BLOCKED_CHANNEL_IDS=none                  # disable blocklist

# ── X cookies (required by xradar + xfeed) ──
# X_COOKIES_JSON=              # raw cookie array JSON (preferred on Railway)
# X_COOKIES_PATH=./cookies.json
# X_LIST_TIMELINE_QUERY_ID=    # override if ListLatestTweetsTimeline 401s (hash rotated)
# X_FOLLOWERS_QUERY_ID=        # override if /early first-followers 404s (hash rotated)
# FOLLOWERS_PAGE_COUNT=20      # same cookie session as follow-radar; keep modest

# ── X follow radar (xradar/) + live feed (xfeed/) ──
# Personal test channel is the default when X_*_CHANNEL_ID is unset.
# X_SCANNER_CHANNEL_ID=1541180128564875304
# XRADAR_ENABLED=false         # new follows from /xwatch accounts
# XRADAR_CHANNEL_ID=           # defaults to X_SCANNER_CHANNEL_ID
# XRADAR_CHANNEL_IDS=          # comma list — follow cards fan out (Bitcernals + TP trenches)
# XRADAR_HANDLES=              # optional seed list (comma-separated)
# XRADAR_POLL_SEC=300
# XRADAR_DEBUG=false
# XFEED_ENABLED=false          # posts + replies from those same accounts (and optional lists)
# XFEED_CHANNEL_ID=            # defaults to X_SCANNER_CHANNEL_ID
# XFEED_LIST_IDS=2091751129990541339
# XFEED_CHANNEL_ID=1541180128564875304
# XFEED_SYNC_LIST_ID=2091751129990541339
# XFEED_ROUTES=2091751129990541339:1541180128564875304
# XFEED_WATCH_RADAR_HANDLES=false  # list is the post source; /xwatch only updates the list + follow radar
# XFEED_HANDLES=               # extra handles beyond /xwatch
# XFEED_POLL_SEC=120
# XFEED_TWEETS_PER_POLL=40
# XFEED_MAX_AGE_MIN=30         # ignore tweets older than this
# XFEED_MAX_PER_CYCLE=15       # flood guard
# XFEED_INCLUDE_REPLIES=true
# XFEED_INCLUDE_RETWEETS=false
# XFEED_MIN_LIKES=0            # 0 = no filtering
# XFEED_REQUIRE_CA=false       # true = only tweets with a CA or $TICKER
# XFEED_KEYWORDS=              # comma list; tweet must contain one
# XFEED_DEBUG=false            # logs seen/posted/dropped per cycle

# ── Knowledge archive (same Discord bot, separate SQLite file) ──
# Unset = off. Telegram must leave this unset. Rollback: KB_ENABLED=false.
# KB_ENABLED=true
# OPENROUTER_API_KEY=sk-or-v1-...
# KB_GUILD_ID=1358929055105159229           # tp4aph; unset = GUILD_ID (BitCERNials)
# KB_CHANNEL_IDS=1452152164699869298        # #the-trenches (omit = all channels in that guild)
# KB_DATA_DIR=/data/knowledge-tp4aph        # default /data/knowledge — keep personal archive out of /ask
# KB_EXCLUDE_CHANNEL_IDS=
# KB_POST_CHANNEL_ID=               # weekly roundup; blank = silent (use /roundup)
# KB_BACKFILL_ON_BOOT=1
# KB_BACKFILL_MAX_AGE_HOURS=72      # 0 = full history later
# KB_MENTION_ANSWERS=0              # 1 = @bot question → /ask
# KB_EXTRACT_MODEL=anthropic/claude-haiku-4.5
# KB_ANSWER_MODEL=anthropic/claude-sonnet-4.6
