# --- Knowledge Bot (separate Discord application from any other bot) ---
DISCORD_TOKEN=knowledge_bot_token_from_developer_portal
CLIENT_ID=knowledge_bot_application_id
KB_GUILD_ID=your_server_id
OPENROUTER_API_KEY=sk-or-v1-...

# Which channels to archive: 'all' or comma-separated channel IDs (threads of
# included channels are archived automatically; private archived threads are not)
KB_CHANNEL_IDS=all
KB_EXCLUDE_CHANNEL_IDS=

# Where the weekly roundup posts (blank = disabled, /roundup still works)
KB_POST_CHANNEL_ID=

# Storage (mount a Railway volume here)
DATA_DIR=./data

# Models (OpenRouter slugs)
KB_EXTRACT_MODEL=anthropic/claude-haiku-4.5
KB_ANSWER_MODEL=anthropic/claude-sonnet-4.6

# Schedules
KB_EXTRACT_CRON=15 * * * *
KB_ROUNDUP_CRON=0 17 * * 5
KB_TZ=UTC

# Behavior
KB_MAX_WINDOWS_PER_RUN=20
KB_BACKFILL_ON_BOOT=1
# First-run cap: only page messages from the last N hours (default 72).
# Stops Discord history pagination from walking years of chat. Live sync
# still archives new messages after that. Set 0 later for full history.
KB_BACKFILL_MAX_AGE_HOURS=72
KB_MENTION_ANSWERS=1
KB_ANONYMIZE=0
