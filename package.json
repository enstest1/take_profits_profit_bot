  "dependencies": {
    "@napi-rs/canvas": "^1.0.0",
    "better-sqlite3": "^11.10.0",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "goat-x-pro": "^0.1.1",
    "linkedom": "^0.18.13",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "viem": "^2.55.2",
    "x-client-transaction-id": "^0.3.1"
