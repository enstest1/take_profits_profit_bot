{
  "name": "take-profits-bot",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/write-deploy-sha.mjs",
    "start": "node start.mjs",
    "start:warden": "node warden/index.js",
    "warden:test": "node warden/tests/acceptance.mjs",
    "test:x": "node scripts/test-x-social.mjs",
    "inspect": "node scripts/inspect-tracked.mjs",
    "test:summary": "node scripts/test-daily-summary.mjs",
    "tp:sample": "node scripts/send-tp-sample-embeds.mjs",
    "test:fib": "node --test fib/tests/engine.test.mjs fib/tests/swingDetector.test.mjs fib/tests/minuteBars.test.mjs",
    "test:tg": "node --test tests/telegram/*.test.mjs",
    "test:mintscan": "node --test tests/mintscan.test.mjs",
    "test:xfeed": "node --test tests/xfeed.test.mjs",
    "test:xradar": "node --test tests/xradar.test.mjs",
    "test:nfttp": "node --test tests/nfttp.test.mjs",
    "test:kb": "node knowledge-bot/scripts/smoke.mjs",
